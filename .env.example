# ==========================================================================
# Instaflow — Environment Configuration Template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ==========================================================================

# --------------------------------------------------------------------------
# Application
# --------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
APP_NAME=Instaflow
# Public URL of the SaaS application (frontend)
CLIENT_URL=http://localhost:5173
# Public URL of the API (used for Meta OAuth redirect / Razorpay callbacks)
API_URL=http://localhost:4000/api
# Internal (docker network) frontend URL used for CORS + emails
INTERNAL_CLIENT_URL=http://localhost:5173
# Canonical base of the link-in-bio pages, e.g. https://instaflow.com
APP_BASE_URL=http://localhost:5173

# --------------------------------------------------------------------------
# MongoDB
# --------------------------------------------------------------------------
MONGODB_URI=mongodb://mongodb:27017/instaflow
MONGO_DB_NAME=instaflow

# --------------------------------------------------------------------------
# Redis
# --------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379
REDIS_DB=0

# --------------------------------------------------------------------------
# JWT / Sessions / Encryption
# --------------------------------------------------------------------------
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# 64 hex chars (32 bytes) — used for AES-256-GCM encryption of OAuth tokens at rest
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
COOKIE_SECURE=false
# Extra browser origins allowed to call the API.
# The app's own origin is ALWAYS allowed automatically (the SPA and API are
# served from the same host behind Nginx), so you only need to list origins
# that live on a *different* host. Use "*" to allow every origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:4000,http://localhost,http://127.0.0.1
# Bootstrap super-admin (only created on first boot)
ADMIN_EMAIL=admin@instaflow.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Platform Admin

# --------------------------------------------------------------------------
# Meta / Instagram Graph API
# --------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
META_REDIRECT_URI=http://localhost:4000/api/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=instaflow_webhook_verify_token
# development | live
META_APP_MODE=development
# Permissions requested (Instagram Messaging + Instagram Basic Display + Content)
META_SCOPES=instagram_basic,instagram_manage_messages,instagram_manage_comments,pages_show_list,pages_read_engagement,instagram_manage_insights

# --------------------------------------------------------------------------
# Razorpay (Billing)
# --------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER_MONTHLY=
RAZORPAY_PLAN_STARTER_YEARLY=
RAZORPAY_PLAN_GROWTH_MONTHLY=
RAZORPAY_PLAN_GROWTH_YEARLY=
RAZORPAY_PLAN_BUSINESS_MONTHLY=
RAZORPAY_PLAN_BUSINESS_YEARLY=

# --------------------------------------------------------------------------
# Email (SMTP) — verification / password reset
# --------------------------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Instaflow <no-reply@instaflow.com>

# --------------------------------------------------------------------------
# Google OAuth
# --------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# --------------------------------------------------------------------------
# AWS S3 (file storage / link-in-bio assets)
# --------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=instaflow-assets
AWS_S3_PUBLIC_URL=https://instaflow-assets.s3.amazonaws.com
# Use "local" to store uploads on the local filesystem volume instead of S3
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/app/uploads

# --------------------------------------------------------------------------
# Rate limiting
# --------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20
WEBHOOK_RATE_LIMIT_MAX=3000

# --------------------------------------------------------------------------
# Link-in-bio / custom domains
# --------------------------------------------------------------------------
LINK_DOMAIN_BASE=localhost:5173
CUSTOM_DOMAIN_ENABLED=false

# --------------------------------------------------------------------------
# Admin panel
# --------------------------------------------------------------------------
ADMIN_PANEL_ENABLED=true
